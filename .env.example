# Vivarium URL for adapters (no trailing slash)
VIVARIUM_URL=http://127.0.0.1:8787

# Optional bearer token (must match API VIVARIUM_TOKEN)
# VIVARIUM_TOKEN=

# SQLite file path (default: ./data/vivarium.db relative to API cwd)
# VIVARIUM_DB_PATH=./data/vivarium.db

# Light router model. Unset = rules only (low confidence → inbox).
# stub = deterministic fake (`llm:<line>` in cwd/task). No network.
# VIVARIUM_LIGHT_MODEL=stub
# Optional HTTP hook. Both must be set or the hook stays off. Failures abstain to inbox.
# VIVARIUM_LIGHT_MODEL_URL=
# VIVARIUM_LIGHT_MODEL_API_KEY=
