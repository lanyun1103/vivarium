{
  "name": "@vivarium/api",
  "version": "0.1.0",
  "description": "Vivarium ingest API with SQLite persistence (M1)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "node --import tsx src/smoke-persistence.ts",
    "test": "node --import tsx --test src/m7.test.ts"
  },
  "dependencies": {
    "@vivarium/schema": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0"
}
