{
  "name": "@vivarium/sdk",
  "version": "0.1.0",
  "description": "Thin HTTP client for Vivarium event ingest",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vivarium/schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0"
}
